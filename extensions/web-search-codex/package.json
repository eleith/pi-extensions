{
  "name": "@eleith-pi/web-search-codex",
  "version": "0.1.0",
  "private": false,
  "description": "One small Codex-native web search tool for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eleith/pi-extensions.git",
    "directory": "extensions/web-search-codex"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --external:@earendil-works/* --external:typebox",
    "prepack": "pnpm build",
    "lint": "oxlint --deny-warnings --config ../../.oxlintrc.json src",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@eleith/pi-internal": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
